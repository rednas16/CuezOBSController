# Copy this file to `.env` and fill in your own values.
# `.env` is ignored by git, so your password never ends up in the repository.

# Address of the OBS WebSocket server, used by `npm run dev`.
# - OBS on this computer:    ws://localhost:4455
# - OBS on another computer: ws://<ip-of-that-computer>:4455
OBS_WS_URL=ws://localhost:4455

# Address of OBS as seen from inside the Docker container (docker compose).
# "host.docker.internal" means: the computer that runs Docker.
OBS_WS_URL_DOCKER=ws://host.docker.internal:4455

# Password set in OBS under Tools > WebSocket Server Settings.
# Leave empty if authentication is disabled in OBS.
OBS_WS_PASSWORD=

# Log level for the server: trace | debug | info | warn | error
LOG_LEVEL=info
